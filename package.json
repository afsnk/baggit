{
  "name": "@baggit/labs",
  "version": "0.0.1",
  "description": "Minimal, modern stablecoin payment modal (npm + shadcn/ui)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C packages/demo dev",
    "dev:merchant": "turbo dev --filter=@baggit/merchant",
    "dev:pay": "turbo dev --filter=@baggit/pay",
    "build": "pnpm -r --filter ./packages build",
    "build:npm": "pnpm -C packages/npm build",
    "build:registry": "pnpm -C packages/registry build",
    "build:packages:server": "pnpm --filter @afsnk/pay-server build",
    "start:packages:server": "pnpm --filter @afsnk/pay-server start",
    "build:packages:api": "bun run --filter @baggit/api build",
    "build:packages:templates": "bun run --filter @baggit/template build",
    "start:packages:api": "bun run --filter @baggit/api start:api",
    "start:packages:auth": "bun run --filter @baggit/api start:auth",
    "start:worker:email": "bun run --filter @baggit/api start:worker:email",
    "start": "pnpm -C packages/demo start",
    "lint": "pnpm -r lint",
    "publish:npm": "pnpm -C packages/npm publish --access public",
    "publish:registry": "pnpm -C packages/registry publish --access public",
    "deploy:server": "flyctl deploy --config ./packages/server/fly.toml --dockerfile ./packages/server/api.Dockerfile",
    "deploy:server:staging": "flyctl deploy --config ./packages/server/fly.staging.toml --dockerfile ./packages/server/staging.api.Dockerfile",
    "deploy:api": "flyctl deploy --no-cache --config ./packages/api/fly.toml",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "keywords": [
    "stablecoin",
    "payment",
    "modal",
    "web3",
    "blockchain",
    "cryptocurrency",
    "react",
    "shadcn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/afsnk/baggit.git"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.1.21",
    "@elysia/eden": "1.4.9",
    "better-auth": "1.7.18",
    "better-result": "^2.9.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.44.4",
    "drizzle-zod": "^0.8.3",
    "nitro": "3.0.261103-rc",
    "nuban-prediction": "^1.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "turbo": "^2.9.7",
    "typescript": "5.7.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "overrides": {
      "rolldown": "1.2.4",
      "tslib": "^2.8.0",
      "better-auth": "1.7.18",
      "@better-auth/core": "1.7.18",
      "@better-auth/api-key": "1.7.18"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@10.3.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
