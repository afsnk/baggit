{
  "name": "@baggit/api",
  "description": "Split API process to handle global auth and api requests",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:auth": "portless auth.baggit --app-port 8002 bun --bun run --watch src/auth.app.ts",
    "dev:api": "PORTLESS_NGROK=1 portless api.baggit --app-port 8001 bun --bun run --watch src/api.app.ts",
    "start:auth": "bun --bun run dist/src/auth.app.js",
    "start:api": "bun --bun run dist/src/api.app.js",
    "start:worker:email": "bun --bun run dist/src/Core/Workers/email.worker.js",
    "db:generate": "npx drizzle-kit generate --config ./dist/drizzle.config.js",
    "db:migrate": "npx drizzle-kit migrate --config ./dist/drizzle.config.js",
    "db:push": "npx drizzle-kit push --config ./dist/drizzle.config.js",
    "check-types": "bunx tsc --noEmit",
    "build": "tsc && tsc-alias"
  },
  "exports": {
    "./app": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "dependencies": {
  	"@baggit/template": "workspace:*",
    "@better-auth/api-key": "^1.6.22",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/openapi": "^1.4.15",
    "@libsql/client": "^0.17.3",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@sinclair/typebox": "^0.34.49",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.10",
    "better-auth": "1.6.9",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "drizzle-orm": "0.44.4",
    "drizzle-zod": "^0.8.3",
    "elysia": "latest",
    "evlog": "^2.14.1",
    "jose": "^6.2.3",
    "tslib": "^2.8.1",
    "typebox": "^1.1.37",
    "viem": "^2.54.3",
    "zod": "^4.4.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "0.31.6"
  },
  "resolutions": {
    "drizzle-orm": "0.44.4"
  },
  "module": "src/index.ts"
}
