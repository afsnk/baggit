{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "noEmit": false,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@core/*": ["./src/v1.0/*"], //Replace active version
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/v1.0/**/*.ts", "src/shared/**/*.ts"], // Include active version
  "exclude": ["node_modules", "dist"]
}
