{
  "name": "@baggit/core",
  "description": "Runtime agnostic, adaptive provider route aggregator.",
  "version": "0.0.1",
  "exports": {
    "./v1.0": {
    	"import": "./dist/v1.0/index.js",
	    "types": "./dist/v1.0/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
	  "@elysia/cors": "^1.4.2",
	  "@elysia/openapi": "^1.4.15",
	  "@elysiajs/openapi": "^1.4.15",
		"@better-auth/api-key": "1.6.30",
		"better-auth": "1.6.30",
    "nats": "^2.29.1",
    "zod": "^4.4.1",
    "drizzle-orm": "0.44.4",
    "drizzle-zod": "^0.8.3",
    "@libsql/client": "^0.14.0",
    "better-sqlite3": "^11.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "elysia": "latest",
    "evlog": "^2.14.1",
    "jose": "^6.2.3",
    "tslib": "^2.8.1",
    "typebox": "^1.1.37",
    "viem": "^2.54.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.4.0",
    "vitest": "^3.0.5",
    "bun-types": "^1.3.11",
    "drizzle-kit": "0.31.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.2"
  },
  "resolutions": {
    "drizzle-orm": "0.44.4",
    "zod": "4.4.1"
  },
  "module": "src/index.ts"
}
