{
  "name": "@baggit/core",
  "version": "0.0.1",
  "description": "Runtime agnostic, adaptive provider route aggregator.",
  "private": true,
  "type": "module",
  "exports": {
    "./services": {
	    	"import": "./dist/src/services/index.js",
	     "types": "./dist/src/services/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "nats": "^2.29.1",
    "zod": "^3.24.5",
    "drizzle-orm": "0.44.4",
    "drizzle-zod": "^0.8.3",
    "@libsql/client": "^0.14.0",
    "better-sqlite3": "^11.9.1",
    "drizzle-kit": "^0.30.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.4.0",
    "vitest": "^3.0.5",
    "bun-types": "^1.3.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.2"
  }
}
