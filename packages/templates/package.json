{
  "name": "@baggit/template",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:email": "email build --dir ./src/emails",
    "build": "tsup",
    "dev": "email dev  --dir ./src/emails",
    "export": "email export --dir ./src/emails --outDir ./out",
    "clean": "rm -rf dist out .turbo"
  },
  "exports": {
    ".": {
	    "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "dependencies": {
    "react-email": "6.9.0",
    "react-dom": "19.2.4",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsup": "^8.5.1"
  }
}
